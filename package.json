{
  "name": "football-predictor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "fetch-data": "tsx scripts/fetch-data.ts --all",
    "fetch-data:championship": "tsx scripts/fetch-data.ts --competition efl-championship",
    "fetch-data:league-one": "tsx scripts/fetch-data.ts --competition efl-league-one",
    "fetch-data:league-two": "tsx scripts/fetch-data.ts --competition efl-league-two",
    "fetch-data:premier-league": "tsx scripts/fetch-data.ts --competition premier-league",
    "fetch-teams": "tsx scripts/fetch-teams.ts --all",
    "fetch-teams:championship": "tsx scripts/fetch-teams.ts --competition efl-championship",
    "fetch-teams:league-one": "tsx scripts/fetch-teams.ts --competition efl-league-one",
    "fetch-teams:league-two": "tsx scripts/fetch-teams.ts --competition efl-league-two",
    "fetch-teams:premier-league": "tsx scripts/fetch-teams.ts --competition premier-league",
    "fetch-fotmob-stats": "tsx scripts/fetch-fotmob-stats.ts --all",
    "fetch-fotmob-stats:championship": "tsx scripts/fetch-fotmob-stats.ts --competition efl-championship",
    "fetch-fotmob-stats:league-one": "tsx scripts/fetch-fotmob-stats.ts --competition efl-league-one",
    "fetch-fotmob-stats:league-two": "tsx scripts/fetch-fotmob-stats.ts --competition efl-league-two",
    "fetch-fotmob-stats:premier-league": "tsx scripts/fetch-fotmob-stats.ts --competition premier-league",
    "generate-predictions": "python3 scripts/generate-predictions.py --all --simulations 50000",
    "generate-predictions:championship": "python3 scripts/generate-predictions.py --competition efl-championship --simulations 50000",
    "generate-predictions:league-one": "python3 scripts/generate-predictions.py --competition efl-league-one --simulations 50000",
    "generate-predictions:league-two": "python3 scripts/generate-predictions.py --competition efl-league-two --simulations 50000",
    "generate-predictions:premier-league": "python3 scripts/generate-predictions.py --competition premier-league --simulations 50000",
    "generate-live-scores": "tsx scripts/generate-live-scores.ts --all",
    "generate-live-scores:championship": "tsx scripts/generate-live-scores.ts --competition efl-championship",
    "generate-live-scores:league-one": "tsx scripts/generate-live-scores.ts --competition efl-league-one",
    "generate-live-scores:league-two": "tsx scripts/generate-live-scores.ts --competition efl-league-two",
    "generate-live-scores:premier-league": "tsx scripts/generate-live-scores.ts --competition premier-league",
    "live-scores:watch": "tsx scripts/watch-live-scores.ts --all",
    "ensure-data-stubs": "tsx scripts/ensure-data-stubs.ts",
    "preview": "vite preview",
    "check-for-updates": "tsx scripts/check-for-updates.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.18",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "modern-screenshot": "^4.6.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "react-select": "^5.10.2",
    "recharts": "^3.8.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/react-vite": "^10.2.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vanilla-extract/css": "^1.18.0",
    "@vanilla-extract/vite-plugin": "^5.1.4",
    "@vitejs/plugin-react": "^5.1.1",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "storybook": "^10.2.19",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
